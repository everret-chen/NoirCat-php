APP_NAME=NoirCat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# 时区与语言（i18n：中文为默认，英文兜底）
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# --- MySQL 8 (Phase 3 起的目标数据库) -------------------------------------
# 切换前先看 docs/audit/mysql-portability.md：需要启用 php 的 pdo_mysql 扩展。
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=noircat
# DB_USERNAME=noircat
# DB_PASSWORD=
# DB_COLLATION=utf8mb4_0900_ai_ci   # MySQL 8 默认；不要用 utf8mb4_unicode_ci（emoji 会被判等）
# DB_ENGINE=InnoDB                  # 缺省会跟服务器默认走，MyISAM 会静默丢掉外键
# DB_TIMEZONE=+08:00                # 与 APP_TIMEZONE 对齐，避免两种时钟混用

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailbox gate for forum writes. Keep true in production: the gate is enforced
# there regardless of this value. Set false locally when there is no mail
# channel at all (see README, "收不到验证邮件").
NOIRCAT_REQUIRE_VERIFIED_EMAIL=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
